; Engine configuration file for Project Earth.
; Generated as part of Stage 2.3 / 2.4 implementation.

config_version=5

[application]

config/name="Project Earth"
config/description="An Earth-inspired open-world life simulation game with intelligent NPCs, shared world, and real-life activity simulation."
config/version="0.0.1-alpha"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=ForwardPlus

[autoload]

GameManager="*res://autoload/GameManager.gd"
WorldTime="*res://autoload/WorldTime.gd"
MemoryEventBus="*res://autoload/MemoryEventBus.gd"
MemoryStore="*res://autoload/MemoryStore.gd"
EconomyManager="*res://autoload/EconomyManager.gd"
WorldServerBridge="*res://autoload/WorldServerBridge.gd"
SaveManager="*res://scripts/save/SaveManager.gd"
DebugManager="*res://autoload/DebugManager.gd"
DebugConsole="*res://scripts/debug/DebugConsole.gd"
PerformanceMonitor="*res://scripts/debug/PerformanceMonitor.gd"
WorldInspector="*res://scripts/debug/WorldInspector.gd"
NPCManager="*res://autoload/NPCManager.gd"
PlayerStats="*res://autoload/PlayerStats.gd"
MoneySystem="*res://autoload/MoneySystem.gd"
InventorySystem="*res://autoload/InventorySystem.gd"
PhoneSystem="*res://autoload/PhoneSystem.gd"
ItemDatabase="*res://scripts/items/ItemDatabase.gd"
ShopUIManager="*res://scripts/ui/ShopUIManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/size/borderless=false
window/size/fullscreen=false
window/vsync/vsync_mode=2

